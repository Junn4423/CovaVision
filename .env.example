APP_NAME="CovaVision API"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# MySQL is the canonical production database.
DATABASE_URL=mysql://covavision:change-me@127.0.0.1:3306/covavision

# Optional local development settings.
JWT_SECRET=change-me-in-development
# Optional independent key for camera credentials. Set a stable value in production.
CAMERA_ENCRYPTION_KEY=
# Optional independent key for face embeddings. Set a stable value in production.
BIOMETRIC_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_SECONDS=28800
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,null
FACE_MATCH_THRESHOLD=0.60
FACE_DETECTION_THRESHOLD=0.35
FACE_DETECTION_WIDTH=640
FACE_DETECTION_HEIGHT=640
FACE_CANDIDATE_CACHE_SECONDS=2
ATTENDANCE_SNAPSHOT_ENABLED=false
ATTENDANCE_SNAPSHOT_RETENTION_DAYS=30

# SaaS plans / payment providers. Sandbox is the safe default; production
# only uses provider keys when PAYMENT_ENVIRONMENT=production.
TRIAL_DURATION_DAYS=14
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_REQUEST_TIMEOUT_SECONDS=10
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=VCB
VIETQR_BANK_ACCOUNT=
VIETQR_BANK_CODE=VCB
VIETQR_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_ORDER_PREFIX=CV
PAYMENT_ORDER_TTL_MINUTES=15

# MoMo sandbox/production credentials (keep server-side).
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# ZaloPay sandbox/production credentials (keep server-side).
ZALOPAY_APP_ID=0
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_REDIRECT_URL=
ZALOPAY_CALLBACK_URL=

# Stripe sandbox/production credentials (keep server-side).
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
STRIPE_ALLOW_LIVE_MODE=false
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Google Identity Services. The backend verifies the ID token; it never trusts
# an email or subject sent directly by the browser.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAIN=
