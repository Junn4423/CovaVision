{
  "name": "ChamCongMobile",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "postinstall": "node ./scripts/fix-react-native-sqlite-storage.js && node ./scripts/fix-react-native-tts.js && node ./scripts/fix-react-native-vlc.js",
    "start": "react-native start",
    "test": "jest",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "android:assemble:debug": "cd android && ./gradlew assembleDebug && cd ..",
    "android:assemble:release": "cd android && ./gradlew assembleRelease && cd ..",
    "build:android:dev": "npm run android:assemble:debug",
    "build:android:prod": "npm run android:assemble:release",
    "build:apk": "./build_apk.sh",
    "build:prod": "npm run build:android:prod"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "buffer": "^6.0.3",
    "jpeg-js": "^0.4.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-camera-kit": "^17.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-tts": "^4.1.1",
    "react-native-udp": "^4.1.7",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vlc-media-player": "^1.0.98",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
